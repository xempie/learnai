{
  "name": "learn-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --if-present run build",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @learn-ai/db run migrate:up",
    "db:migrate:down": "pnpm --filter @learn-ai/db run migrate:down",
    "db:seed": "pnpm --filter @learn-ai/db run seed"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
