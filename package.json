{
  "name": "learnai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "setup": "pnpm db:up && pnpm db:push && pnpm db:seed",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1101.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/client-sesv2": "^3.1101.0",
    "@aws-sdk/cloudfront-signer": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
