# Copy to .env.local for local development.
# Nothing secret belongs in a NEXT_PUBLIC_* variable - those are compiled into
# the client bundle (TECHNICAL_SPEC §10.1).

# ---------- Core ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AWS_REGION=ap-southeast-2

# ---------- Database ----------
# Local: docker compose up -d  (see README)
DATABASE_URL=postgres://acadu:acadu@localhost:5433/acadu
# Production reads the real URL from Secrets Manager at cold start.
DATABASE_SECRET_ARN=

# ---------- Auth (Cognito) ----------
# Leave COGNITO_USER_POOL_ID empty to run in DEV AUTH mode: signup/login work
# against the local database with a signed dev cookie, no AWS account required.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Hosted UI domain, e.g. acadu-auth.auth.ap-southeast-2.amazoncognito.com
COGNITO_DOMAIN=
# Google federation is configured on the pool; this only toggles the button.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true
# 32+ random chars. Signs the local session cookie.
AUTH_SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------- Storage / CDN ----------
S3_VIDEO_BUCKET=acadu-video-dev
S3_ASSETS_BUCKET=acadu-assets-dev
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
# Local dev writes uploads to ./public/uploads instead of S3 when this is true.
USE_LOCAL_UPLOADS=true

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_INDIVIDUAL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Email ----------
# Transactional mail goes through the data-corner.com.au mailbox for the pilot.
# Leave SMTP_PASS empty and messages are logged to the console instead of sent.
SMTP_HOST=mail.data-corner.com.au
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@data-corner.com.au
SMTP_FROM_NAME=Acadu

# SES is the eventual target once production access is approved.
SES_FROM_ADDRESS=no-reply@data-corner.com.au
SES_CONFIGURATION_SET_TRANSACTIONAL=

# ---------- Booking ----------
# your cal.com username — booking embed hides until set
NEXT_PUBLIC_CALCOM_HANDLE=

# ---------- Leads ----------
# Where new service enquiries (POST /api/v1/enquiries) are sent.
LEAD_NOTIFY_EMAIL=afhayati@gmail.com

# ---------- Drafts ----------
# bearer token for the external drafting agents; ingestion is 501 until set
DRAFT_INGEST_TOKEN=

# ---------- Feature flags ----------
FEATURE_COMMENTS=true
FEATURE_SEARCH=false
FEATURE_SHARE=true
FEATURE_FREE_PLATFORM=true
# Client-side mirror of FEATURE_FREE_PLATFORM - keep these in sync. Compiled
# into the bundle, so it gates rendering (billing UI, trial countdown) only.
NEXT_PUBLIC_FREE_PLATFORM=true
FEATURE_BILLING=false
MIN_COHORT_DISPLAY=5
FOUNDING_MEMBER_LIMIT=25
FREE_VIDEO_COUNT=3
# Episodes of ANY topic a non-paying account may watch (trial included).
PREVIEW_EPISODE_COUNT=2
TRIAL_DAYS=7
TRIAL_REQUIRES_CARD=false
MAX_NEW_CONTENT_NOTIFICATIONS_PER_DAY=3
COMMENT_RATE_LIMIT_PER_10MIN=5
