{
  "name": "@learn-ai/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "migrate:up": "dotenv -e ../../.env.local -- node-pg-migrate up",
    "migrate:down": "dotenv -e ../../.env.local -- node-pg-migrate down",
    "seed": "dotenv -e ../../.env.local -- tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@learn-ai/cohort": "workspace:*",
    "pg": "^8.13.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.4",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
